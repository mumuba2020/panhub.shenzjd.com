# 环境变量示例（复制为 .env 后修改）

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# 热搜存储（每日搜索词）：需记录/查看搜索趋势时配置，默认走内存（重启后丢失）。
TURSO_URL=
TURSO_AUTH_TOKEN=

# 频道清单解密密钥（64 位 hex），用于解密频道配置。
CHANNEL_KEY=

# wx-auth 认证服务地址（2026-08-28 起唯一登录通道：小程序 Bearer token 与
# 网页端公众号 cookie 均转发该服务的 /api/auth/check 校验）
WX_AUTH_API_BASE=https://wx-auth.shenzjd.com